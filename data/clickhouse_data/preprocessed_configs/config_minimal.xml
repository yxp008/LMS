<clickhouse>
    <path>/home/yxp/LMS_mimo/data/clickhouse_data/</path>
    <tmp_path>/home/yxp/LMS_mimo/data/clickhouse_data/tmp/</tmp_path>
    <user_files_path>/home/yxp/LMS_mimo/data/clickhouse_data/user_files/</user_files_path>
    <format_schema_path>/home/yxp/LMS_mimo/data/clickhouse_data/format_schemas/</format_schema_path>
    <logger>
        <level>warning</level>
        <log>/home/yxp/LMS_mimo/data/clickhouse_data/clickhouse-server.log</log>
        <errorlog>/home/yxp/LMS_mimo/data/clickhouse_data/clickhouse-server.err.log</errorlog>
    </logger>
    <http_port>8123</http_port>
    <tcp_port>9000</tcp_port>
    <listen_host>127.0.0.1</listen_host>
    <max_connections>1024</max_connections>
    <default_database>default</default_database>
    <profiles>
        <default>
            <max_threads>8</max_threads>
            <use_uncompressed_cache>0</use_uncompressed_cache>
        </default>
    </profiles>
    <users>
        <default>
            <password></password>
            <networks><ip>::/0</ip></networks>
            <profile>default</profile>
            <quota>default</quota>
        </default>
    </users>
    <storage_configuration>
        <disks>
            <warm_disk>
                <path>/home/yxp/LMS_mimo/data/clickhouse_data/warm/</path>
            </warm_disk>
            <cold_disk>
                <path>/home/yxp/LMS_mimo/data/clickhouse_data/cold/</path>
            </cold_disk>
        </disks>
        <policies>
            <hot_warm_cold>
                <volumes>
                    <default_volume>
                        <disk>default</disk>
                    </default_volume>
                    <warm_volume>
                        <disk>warm_disk</disk>
                    </warm_volume>
                    <cold_volume>
                        <disk>cold_disk</disk>
                    </cold_volume>
                </volumes>
            </hot_warm_cold>
        </policies>
    </storage_configuration>
</clickhouse>
