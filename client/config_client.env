# LMS 客户端配置文件
# 启动方式: bash start_client.sh
#
#   ⚠️ 将下面两个地址改为你的服务端局域网 IP
#   例如服务端 IP 是 192.168.1.100：
#     LMS_KAFKA_BROKER=192.168.1.100:9092
#     LMS_SERVER_URL=http://192.168.1.100:8080

# 采集器管理端口
COLLECTOR_PORT=8081

# ===== 修改为服务端 IP =====
LMS_KAFKA_BROKER=localhost:9092
LMS_SERVER_URL=http://localhost:8080

# Vector 二进制路径（可选，默认 $HOME/.vector/bin/vector）
# LMS_VECTOR_BIN=$HOME/.vector/bin/vector
