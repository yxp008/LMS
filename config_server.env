# LMS 服务端配置文件
# 启动方式: bash start_server.sh

# Web 服务端口
SERVER_PORT=8080

# ClickHouse 地址（服务端本机）
LMS_CLICKHOUSE_URL=http://localhost:8123

# Kafka broker 地址（服务端本机）
LMS_KAFKA_BROKER=localhost:9092

# 服务端自身地址（供采集器注册，本机）
LMS_SERVER_URL=http://localhost:8080

# Kafka 安装目录
KAFKA_HOME=$HOME/kafka

# syslog 端口
SYSLOG_PORT=1514
