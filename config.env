# LMS 配置文件 — 修改端口和地址后重新启动即可生效
# ===== 跨机器部署时修改以下地址 =====

# 服务端 Web 端口
SERVER_PORT=8080

# 采集器管理端口
COLLECTOR_PORT=8081

# ClickHouse HTTP 地址（处理器和服务端使用）
LMS_CLICKHOUSE_URL=http://localhost:8123

# Kafka broker 地址（处理器和采集器使用）
LMS_KAFKA_BROKER=localhost:9092

# 服务端地址（采集器注册目标，客户端部署时改为服务端IP）
LMS_SERVER_URL=http://localhost:8080

# Vector 二进制路径
LMS_VECTOR_BIN=$HOME/.vector/bin/vector

# Kafka 安装目录
KAFKA_HOME=$HOME/kafka

# Vector syslog 端口
SYSLOG_PORT=1514
